# 单镜头创作：复制为 backend/.env，并在本机配置密钥，勿提交 .env。
VOICECANVAS_SHOT_LLM_BASE_URL=https://api.commandcode.ai/provider/v1
VOICECANVAS_SHOT_LLM_MODEL=deepseek/deepseek-v4.1-flash
VOICECANVAS_SHOT_LLM_API_KEY=
# 当前供应商通过 reasoning_effort=off 关闭深度思考，优先快速出图。
# low 保留少量思考；其他兼容供应商不支持时设 provider-default（不发送此参数）。
VOICECANVAS_SHOT_REASONING_EFFORT=off
VOICECANVAS_SHOT_MAX_TOKENS=32768
VOICECANVAS_SHOT_TIMEOUT_SECONDS=300
# 仅在当前网络 IPv4 TLS 连接中断、IPv6 可用时设置 ::；默认由系统选择。
# VOICECANVAS_SHOT_LOCAL_ADDRESS=::
# 项目绘图 Agent 默认加载内置作画知识；设为 none 回到基础提示。
VOICECANVAS_SHOT_DRAWING_SKILL=svg-illustration
# 默认保存到 backend/data/svg-shots.sqlite3，可改为 D 盘其他路径。
# VOICECANVAS_SHOT_DB_PATH=D:/VoiceCanvas/data/svg-shots.sqlite3
# 视觉工具使用本机 Edge/Chromium，Windows 自动寻找 Edge；不自动安装或下载浏览器。
# 未发现时只让视觉工具明确报错，基本绘制与管理仍可运行。
# VOICECANVAS_RENDER_BROWSER_PATH=D:/Applications/chromium/chrome.exe
